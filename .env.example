# docker compose reads this file. Never commit the filled-in .env.

# Supabase project (Project Settings > API). The publishable key is safe to expose.
SAP_SUPABASE_URL=https://<project-ref>.supabase.co
SAP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Session pooler connection as the least-privilege role created by supabase/migrations.
SAP_DATABASE_URL=postgresql+asyncpg://sap_engine.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?ssl=require

# 32 random bytes, base64: the key-encryption key that wraps every dataset key.
# Generate with: cd Backend && uv run python scripts/gen_secrets.py
SAP_MASTER_KEY=

# Public origin the browser uses (also the only allowed CORS origin).
SAP_PUBLIC_ORIGIN=http://localhost:8000

# Optional: enables the AI analyst (natural-language questions, executive summaries).
ANTHROPIC_API_KEY=
