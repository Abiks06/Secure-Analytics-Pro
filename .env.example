# docker compose reads this file. Generate real values with:
#   cd Backend && uv run python scripts/gen_secrets.py
# Never commit the filled-in .env.

# 32 random bytes, base64: the key-encryption key that wraps every dataset key.
SAP_MASTER_KEY=
# Ed25519 private key (PEM, newlines escaped as \n) used to sign access tokens.
SAP_JWT_PRIVATE_KEY=
POSTGRES_ADMIN_PASSWORD=
SAP_DB_PASSWORD=

# Public origin the browser uses (also the only allowed CORS origin).
SAP_PUBLIC_ORIGIN=http://localhost:8000
# Set to true behind HTTPS.
SAP_COOKIE_SECURE=false

# Optional: enables the AI analyst (natural-language questions, executive summaries).
ANTHROPIC_API_KEY=
