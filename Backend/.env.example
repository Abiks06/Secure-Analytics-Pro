# Copy to .env. The engine connects to Supabase Postgres through the session pooler as the
# least-privilege `sap_engine` role created by supabase/migrations (set its password with
# `alter role sap_engine with password '...'` in the SQL editor).
SAP_DATABASE_URL=postgresql+asyncpg://sap_engine.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?ssl=require
SAP_SUPABASE_URL=https://<project-ref>.supabase.co
SAP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Required in production: 32 random bytes, base64 (uv run python scripts/gen_secrets.py)
# SAP_MASTER_KEY=
# Optional: enables the AI analyst
# ANTHROPIC_API_KEY=
